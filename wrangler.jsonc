/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mcp-administracion-fuentes-publicas",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-04",
	"upload_source_maps": true,
	"workers_dev": true,
	"routes": [
		{
			"pattern": "mcp-afp.manalejandro.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false
		}
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "SSE_SESSION",
				"class_name": "SseSession"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SseSession"]
		}
	]
}
